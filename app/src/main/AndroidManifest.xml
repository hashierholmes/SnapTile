<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.snaptile.app">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- FOREGROUND_SERVICE_MEDIA_PROJECTION and the mediaProjection
         foregroundServiceType are deliberately absent since 1.1.14, and 1.1.14
         settled the question they were there to answer: removing them changed
         nothing. SnapTile with no screen-capture permission, no
         foregroundServiceType, no capability and no event types is still flagged,
         and every enabled app that is not flagged now matches or out-declares it
         field for field. Whatever the rule reads, it is not in the manifest.
         The remaining question is what the app says about itself (1.1.15 twin
         service) and whether an unknown app carrying any accessibility service
         is enough on its own (the a11yprobe apps).

         They are the last app-level declaration that says "this app can capture
         the screen itself", and Super Money continues to flag SnapTile after
         1.1.13 reduced the accessibility service to declaring nothing at all
         (capabilities 0x0, event types 0x0) while leaving MediaProjection in
         place. The rule cannot be reading the AccessibilityServiceInfo: every
         field of SnapTile's live info is now a subset of an unflagged service's
         (Twilight: CAN_TAKE_SCREENSHOT + events 0x0, enabled and not flagged;
         Key Mapper: sideloaded and enabled with gestures, key filtering and
         window content, not flagged).

         So this build drops the screen-capture declaration too, which leaves
         capture to performGlobalAction(GLOBAL_ACTION_TAKE_SCREENSHOT) - a
         global action needs no capability and no permission. If the warning
         clears, the trigger is the capture declaration; if it survives, the
         cause is app identity (name, installer, first-install/update dates) and
         no configuration can fix it.

         Revert is one commit: this note, plus ProjectionService's declaration
         below, plus that one permission line. -->

    <!-- Diagnostics enumerates accessibility services to compare install sources.
         Without this, package visibility (targetSdk 34) restricts that list to
         system packages plus SnapTile itself, which is exactly the comparison we
         need to be able to make. Matches any app that declares an accessibility
         service; it grants no access to anything else they do.

         The explicit <package> entries below cover services that are enabled in
         the secure setting but did not appear in that list - naming them is the
         only way to read their install source, capabilities and dates, and those
         are the controls this comparison depends on. -->
    <queries>
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <package android:name="io.github.visnkmr.powermenu" />
        <package android:name="com.olalab.lockscreen" />
        <package android:name="at.saltyy.switchly" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScreenshotTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_screenshot"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".ScreenshotChooserActivity"
            android:exported="false"
            android:theme="@style/TransparentDialogTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:theme="@style/TransparentTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <activity
            android:name=".SnipActivity"
            android:exported="false"
            android:theme="@style/FullscreenTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title" />

        <!-- ProjectionService is NOT declared in 1.1.14: its declaration
             (android:foregroundServiceType="mediaProjection") plus the
             FOREGROUND_SERVICE_MEDIA_PROJECTION permission are the app-level
             "this app can capture the screen" signal this build tests by
             removing. The class is left in the tree so the revert is a manifest
             edit; ScreenshotAccessibilityService checks the declaration before
             routing anything to it. -->

        <!-- Clean screenshot path (PowerMenu-style). Tile/chooser route through
             this service: API 30+ takeScreenshot() returns a Bitmap in-app,
             API 28+ performGlobalAction(TAKE_SCREENSHOT) uses system UI when the
             capability is not declared. Pre-28 needs MediaProjection. -->
        <service
            android:name=".ScreenshotAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Diagnostic twin, 1.1.15. Same service behaviour, same accessibility
             config, different class name and description text. Enable this one
             instead of the service above to test whether the warning reads what
             an app says about itself; keep exactly one of the two enabled. -->
        <service
            android:name=".TileAssistService"
            android:exported="true"
            android:label="@string/a11y_label_twin"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config_twin" />
        </service>

    </application>
</manifest>
