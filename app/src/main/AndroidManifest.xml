<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.snaptile.app">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- MediaProjection is back as of 1.2.0, because the app now offers both
         capture methods and the legacy one is the whole point of having a
         warning-free mode: it captures without any accessibility service
         enabled, which is what bank and UPI apps object to.

         It was removed for 1.1.14 as a test — "does removing the app-level
         screen-capture declaration clear the warning?" — and that test came back
         negative. SnapTile with no mediaProjection permission, no
         foregroundServiceType and no capture capability was flagged exactly as
         before, so the declaration is not what scanners read.

         What the evidence now points at is the accessibility service itself
         being present at all, with the app saying it takes screenshots: the
         widely used ScreenshotTile app (github.com/cvzi/ScreenshotTile) is
         flagged too, and its service declares even less than SnapTile's does —
         one event type and a description, no capability at all. That is a
         property of the category, not of any one manifest entry, which is why
         1.2.0 stops looking for a setting that clears it and lets the user pick
         a method instead. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Diagnostics enumerates accessibility services to compare install sources.
         Without this, package visibility (targetSdk 34) restricts that list to
         system packages plus SnapTile itself, which is exactly the comparison we
         need to be able to make. Matches any app that declares an accessibility
         service; it grants no access to anything else they do.

         The explicit <package> entries below cover services that are enabled in
         the secure setting but did not appear in that list - naming them is the
         only way to read their install source, capabilities and dates, and those
         are the controls this comparison depends on. -->
    <queries>
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <package android:name="io.github.visnkmr.powermenu" />
        <package android:name="com.olalab.lockscreen" />
        <package android:name="at.saltyy.switchly" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScreenshotTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_screenshot"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".ScreenshotChooserActivity"
            android:exported="false"
            android:theme="@style/TransparentDialogTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:theme="@style/TransparentTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <activity
            android:name=".SnipActivity"
            android:exported="false"
            android:theme="@style/FullscreenTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title" />

        <activity
            android:name=".AccessibilitySetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <!-- Legacy capture path. Required by Android for MediaProjection, used by
             CaptureActivity: consent first, then this service establishes the
             foreground context before getMediaProjection() is allowed on
             targetSdk 34. Declared again as of 1.2.0 — see the permission note
             above. Nothing about the accessibility method depends on it. -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Native capture path. Tile/chooser route through this service. Its
             config declares no capability as of 1.2.1 (the ScreenshotTile
             minimum), so API 30+ full-screen captures go through
             performGlobalAction(TAKE_SCREENSHOT) and region/paint captures
             through MediaProjection. The 1.1.15 diagnostic twin service was
             removed in the same release: it existed only for the naming test,
             that test came back negative, and a second accessibility entry in a
             shipped app is a liability rather than a feature. -->
        <service
            android:name=".ScreenshotAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
