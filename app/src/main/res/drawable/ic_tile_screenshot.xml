<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Settings tile icon. QS tiles tint the drawable and ignore multicolor
     artwork, so this must stay a single-color white silhouette (24dp). The old
     ic_screenshot is a full-color 1254px illustration and renders as a blank
     tile — do NOT reference it from the TileService. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Crop-corner marks -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4,8 L4,4 L8,4 M16,4 L20,4 L20,8 M20,16 L20,20 L16,20 M8,20 L4,20 L4,16" />

    <!-- Sun -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,10m-1.4,0a1.4,1.4 0,1 1,2.8 0a1.4,1.4 0,1 1,-2.8 0" />

    <!-- Mountain / image -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8.5,16 L12,11.5 L14.5,14 L16,12.5 L17.5,14 L17.5,16 Z" />

</vector>
