<?xml version="1.0" encoding="utf-8"?>
<!-- Twin of accessibility_service_config.xml, added in 1.1.15.

     Byte-for-byte identical in every accessibility field the platform reports
     (no capabilities, no event types, feedbackGeneric, flagDefault,
     canRetrieveWindowContent=false). The single difference is the description
     text, which here avoids the words the flagged service uses.

     Purpose: the one open question left after 1.1.11-1.1.14 is whether the
     warning keys on what an app *says about itself* - the bound service's class
     name and/or its description string - rather than on anything it declares or
     is capable of. Enabling this service instead of the original tests that
     inside one app, with the package, label, permissions, installer and install
     dates all held constant. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:canRequestTouchExplorationMode="false"
    android:canRequestFilterKeyEvents="false"
    android:canPerformGestures="false"
    android:canTakeScreenshot="false"
    android:description="@string/accessibility_desc_neutral"
    android:summary="@string/accessibility_desc_neutral" />
