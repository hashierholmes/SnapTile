<?xml version="1.0" encoding="utf-8"?>
<!-- Variant A — baseline control.

     Declares nothing but a description: no accessibilityEventTypes, no
     capabilities, no flags. If super.money flags *this* app, then provenance is
     the trigger (sideloaded app + any enabled accessibility service), and
     SnapTile's configuration is irrelevant — no XML value can fix it.

     If this app is not flagged but variant B is, the event type is the trigger,
     and SnapTile can drop it at zero functional cost (its service ignores every
     event it receives). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/probe_label" />
