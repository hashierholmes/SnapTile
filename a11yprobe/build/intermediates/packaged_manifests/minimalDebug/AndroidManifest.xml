<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.snaptile.a11yprobe.minimal"
    android:versionCode="1"
    android:versionName="1.0-minimal" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:label="@string/probe_label"
        android:supportsRtl="true" >
        <activity
            android:name="com.snaptile.a11yprobe.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The payload is the XML this points at, which is what a risk SDK reads. -->
        <service
            android:name="com.snaptile.a11yprobe.ProbeService"
            android:exported="true"
            android:label="@string/probe_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe_service" />
        </service>
    </application>

</manifest>